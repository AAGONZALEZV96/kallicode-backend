{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "api": {
      "root": "apps/api",
      "runtime": "python"
    },
    "workers": {
      "root": "apps/workers",
      "runtime": "python"
    },
    "core": {
      "root": "packages/core",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
