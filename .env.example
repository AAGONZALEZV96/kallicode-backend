# ==============================================================================
# KALLICODE — CONFIGURACIÓN ENTORNO LOCAL / PRUEBAS CERO-NUBE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Entorno y Registros
# ------------------------------------------------------------------------------
KC_ENV=local
KC_LOG_LEVEL=DEBUG
KC_LOG_FORMATO=texto

# ------------------------------------------------------------------------------
# 2. Infraestructura y Puertos Locales (Docker Compose / Test Runner)
# ------------------------------------------------------------------------------
DB_NAME=kallicode_test
PG_PORT=5432
REDIS_PORT=6379
AZURITE_PORT=10000
LLM_STUB_PORT=8081
TEI_PORT=8080
MAILPIT_PORT=1025

# ------------------------------------------------------------------------------
# 3. Base de Datos PostgreSQL 16 + pgvector (Multi-Tenant & RLS)
# ------------------------------------------------------------------------------
# Tareas de sistema y migraciones usan kallicode_admin (BYPASSRLS)
KC_DATABASE_URL_ADMIN=postgresql+asyncpg://kallicode_admin:KalliCode_Dev2026!@localhost:5432/kallicode_test

# API y workers usan kallicode_app (confinado estrictamente por RLS)
KC_DATABASE_URL=postgresql+asyncpg://kallicode_app:KalliCode_Dev2026!@localhost:5432/kallicode_test
KC_DB_PASSWORD=KalliCode_Dev2026!

# ------------------------------------------------------------------------------
# 4. Redis (Colas, Caché y Control de Tasas)
# ------------------------------------------------------------------------------
KC_REDIS_URL=redis://:Redis_Dev2026!@localhost:6379/0
KC_REDIS_PASSWORD=Redis_Dev2026!

# ------------------------------------------------------------------------------
# 5. Almacenamiento de Evidencias (Azurite / Azure Blob Storage Emulado)
# ------------------------------------------------------------------------------
KC_BLOB_ACCOUNT_URL=http://localhost:10000/devstoreaccount1

# ------------------------------------------------------------------------------
# 6. Bóveda de Secretos y JWT
# ------------------------------------------------------------------------------
KC_SECRETS_BACKEND=env
# JWT: Vacíos en local => Genera par efímero RS256 en memoria para desarrollo
KC_JWT_PRIVATE_KEY=
KC_JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 7. Modelos de Lenguaje (LLM Stubs Locales — Cero Nube / Sin Token Real)
# ------------------------------------------------------------------------------
# Apuntan al puerto 8081 donde corre 'llm_stub.py' para respuestas deterministas
KC_LLM_FLASH_BASE_URL=http://localhost:8081/v1
KC_LLM_FLASH_MODEL=deepseek-v4-flash

KC_LLM_PRO_BASE_URL=http://localhost:8081/v1
KC_LLM_PRO_MODEL=deepseek-v4-pro

KC_LLM_FABLE_BASE_URL=http://localhost:8081/v1
KC_LLM_FABLE_MODEL=claude-fable-5
KC_LLM_FABLE_API_KEY=mock-local-key

# ------------------------------------------------------------------------------
# 8. Embeddings BGE-M3 (Servidor TEI Local)
# ------------------------------------------------------------------------------
KC_EMBEDDINGS_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 9. Correo SMTP (Servidor Mailpit Local)
# ------------------------------------------------------------------------------
KC_SMTP_HOST=localhost
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@kallicode.dev

# ------------------------------------------------------------------------------
# 10. CORS y Frontend
# ------------------------------------------------------------------------------
KC_CORS_ORIGINS=http://localhost:5173
