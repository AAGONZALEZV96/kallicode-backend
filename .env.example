# ==============================================================================
# KALLICODE — CONFIGURACIÓN ENTORNO LOCAL / PRUEBAS CERO-NUBE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Entorno y Registros
# ------------------------------------------------------------------------------
KC_ENV=local
KC_LOG_LEVEL=DEBUG
KC_LOG_FORMATO=texto

# ------------------------------------------------------------------------------
# 2. Infraestructura y Puertos Locales (Docker Compose / Test Runner)
# ------------------------------------------------------------------------------
DB_NAME=kallicode_test
PG_PORT=5432
REDIS_PORT=6379
AZURITE_PORT=10000
LLM_STUB_PORT=8081
TEI_PORT=8080
MAILPIT_PORT=1025

# ------------------------------------------------------------------------------
# 3. Base de Datos PostgreSQL 16 + pgvector (Multi-Tenant & RLS)
# ------------------------------------------------------------------------------
# Tareas de sistema y migraciones usan kallicode_admin (BYPASSRLS)
KC_DATABASE_URL_ADMIN=postgresql+asyncpg://kallicode_admin:KalliCode_Dev2026!@localhost:5432/kallicode_test

# API y workers usan kallicode_app (confinado estrictamente por RLS)
KC_DATABASE_URL=postgresql+asyncpg://kallicode_app:KalliCode_Dev2026!@localhost:5432/kallicode_test

# Barridos cross-tenant de los workers: kallicode_worker (solo tablas de cola, KC-DB-02-2)
KC_DATABASE_URL_WORKER=postgresql+asyncpg://kallicode_worker:KalliCode_Dev2026!@localhost:5432/kallicode_test
KC_DB_PASSWORD=KalliCode_Dev2026!

# Cotas del motor de la API (KC-CM-11-5): segundos para conectar y por sentencia. Al vencer, la API
# responde 503 DEPENDENCIA_NO_DISPONIBLE en lugar de quedarse colgada si PostgreSQL desaparece.
KC_DB_CONNECT_TIMEOUT_S=5
KC_DB_COMMAND_TIMEOUT_S=15
# Edad máxima de una conexión del pool de la API (KC-CM-11-6): el motor no hace pre-ping.
KC_DB_POOL_RECYCLE_S=300

# ------------------------------------------------------------------------------
# 4. Redis (Colas, Caché y Control de Tasas)
# ------------------------------------------------------------------------------
KC_REDIS_URL=redis://:Redis_Dev2026!@localhost:6379/0
KC_REDIS_PASSWORD=Redis_Dev2026!

# ------------------------------------------------------------------------------
# 5. Almacenamiento de Evidencias (Azurite / Azure Blob Storage Emulado)
# ------------------------------------------------------------------------------
KC_BLOB_ACCOUNT_URL=http://localhost:10000/devstoreaccount1
# Credenciales públicas del emulador Azurite, solo para desarrollo local.
KC_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"

# Opcional en Azure: ID de una identidad administrada asignada por el usuario.
# Si se deja vacío, se usa la identidad asignada al recurso.
KC_BLOB_MANAGED_IDENTITY_CLIENT_ID=

# ------------------------------------------------------------------------------
# 6. Bóveda de Secretos y JWT
# ------------------------------------------------------------------------------
KC_SECRETS_BACKEND=env
# JWT: Vacíos en local => Genera par efímero RS256 en memoria para desarrollo
KC_JWT_PRIVATE_KEY=
KC_JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 7. Modelos de Lenguaje (LLM Stubs Locales — Cero Nube / Sin Token Real)
# ------------------------------------------------------------------------------
# Apuntan al puerto 8081 donde corre 'llm_stub.py' para respuestas deterministas
KC_LLM_FLASH_BASE_URL=http://localhost:8081/v1
KC_LLM_FLASH_MODEL=deepseek-v4-flash

KC_LLM_PRO_BASE_URL=http://localhost:8081/v1
KC_LLM_PRO_MODEL=deepseek-v4-pro

KC_LLM_FABLE_BASE_URL=http://localhost:8081/v1
KC_LLM_FABLE_MODEL=claude-fable-5
KC_LLM_FABLE_API_KEY=mock-local-key

# Realimentación del grafo desde tickets entregados (KC-CM-10-4): candidatos a nugget e
# incidente, siempre pendientes de curación. Presupuesto en tokens LLM (entrada + salida
# reservada) por ticket, y tope del consumo mensual del tenant por encima del cual no se ejecuta.
KC_CM_REALIMENTACION_HABILITADA=true
KC_CM_REALIMENTACION_TOKENS_TICKET=12000
KC_CM_REALIMENTACION_TOKENS_TENANT_MES=2000000

# ------------------------------------------------------------------------------
# 8. Embeddings BGE-M3 (Servidor TEI Local)
# ------------------------------------------------------------------------------
KC_EMBEDDINGS_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 9. Correo SMTP (Servidor Mailpit Local)
# ------------------------------------------------------------------------------
KC_SMTP_HOST=localhost
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@kallicode.dev

# ------------------------------------------------------------------------------
# 10. CORS y Frontend
# ------------------------------------------------------------------------------
KC_CORS_ORIGINS=https://kallicode.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 11. CodeMapping: ingesta de documentación (KC-CM-08-1, prefijo CM_ de
#     packages/codemapping/config.py)
# ------------------------------------------------------------------------------
CM_BLOB_ACCOUNT_URL=http://localhost:10000/devstoreaccount1
CM_BLOB_CONTAINER=evidencia
CM_DOCS_CHUNK_MAX_CHARS=1500
CM_DOCS_CHUNK_OVERLAP_CHARS=200
CM_DOCS_LINK_THRESHOLD=0.6
CM_DOCS_LINK_TOP_K=5
CM_DOCS_ONTOLOGY_MAX_EXCERPTS=200
CM_TEI_BATCH_SIZE=32
# Rama del repositorio del cliente que se ingiere (KC-CM-12-2; por defecto main)
CM_TARGET_BRANCH=main
# Propuesta de cm.nuggets desde la documentación (KC-CM-08-2): quedan pendientes de curación
CM_NUGGETS_ENABLED=true
CM_NUGGETS_MAX_CHUNKS_POR_LOTE=8
CM_NUGGETS_MAX_CARACTERES_POR_LOTE=12000
# Vigencia de los embeddings (KC-CM-11-4): nodos obsoletos o sin embedding que el refresco diario
# reembebe por corrida (0 = solo mide). Lo que no cabe queda para la corrida siguiente.
CM_VIGENCIA_MAX_REEMBEBIDOS=5000
# Cuota de tokens LLM del tenant por ciclo de facturación (aniversario de la suscripción). La ingesta
# completa no arranca el enriquecimiento si su estimación no cabe en lo que queda (core.usage_tokens).
CM_PRESUPUESTO_TOKENS_TENANT_MES=2000000

# ------------------------------------------------------------------------------
# 12. CodeMapping: escalación humana de una ingesta bloqueada (KC-CM-10-6)
# ------------------------------------------------------------------------------
# Ante credenciales vencidas, repositorio corrupto, tiers del LLM agotados o reintentos
# agotados, el worker pausa el snapshot (pendiente_intervencion) y llama a
# POST <base>/codemapping/escalations con JWT de servicio svc=ingesta.
CM_WORKER_ESCALACION_HABILITADA=true
# Vacío => usa KC_INTERNAL_API_BASE_URL (por defecto http://localhost:8001/internal/v1)
CM_WORKER_ESCALACION_BASE_URL=
# KC-CM-11-4: cada cuántos segundos el worker lee vec.estado_hnsw() y vec.vigencia_global() para
# /metrics (tamaño e hinchazón de los HNSW, vigencia de los embeddings). 0 = nunca.
CM_WORKER_METRICAS_VECTORIALES_CADA_S=300
