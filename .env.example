# ==============================================================================
# KALLICODE · ENTORNO LOCAL / PRUEBAS CERO-NUBE
# ==============================================================================

# ------------------------------------------------------------------------------
# Entorno y logs
# ------------------------------------------------------------------------------
KC_ENV=local
KC_LOG_LEVEL=DEBUG
KC_LOG_FORMATO=texto

# ------------------------------------------------------------------------------
# Puertos locales
# ------------------------------------------------------------------------------
DB_NAME=kallicode_test
PG_PORT=5432
REDIS_PORT=6379
AZURITE_PORT=10000
LLM_STUB_PORT=8081
TEI_PORT=8080
MAILPIT_PORT=1025
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
KC_DATABASE_URL_ADMIN=postgresql+asyncpg://kallicode_admin:KalliCode_Dev2026!@localhost:5432/kallicode_test
KC_DATABASE_URL=postgresql+asyncpg://kallicode_app:KalliCode_Dev2026!@localhost:5432/kallicode_test
KC_DATABASE_URL_WORKER=postgresql+asyncpg://kallicode_worker:KalliCode_Dev2026!@localhost:5432/kallicode_test
KC_DB_PASSWORD=KalliCode_Dev2026!

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
KC_REDIS_URL=redis://:Redis_Dev2026!@localhost:6379/0
KC_REDIS_PASSWORD=Redis_Dev2026!

# ------------------------------------------------------------------------------
# Azure Blob Storage / Azurite
# ------------------------------------------------------------------------------
KC_BLOB_ACCOUNT_URL=http://localhost:10000/devstoreaccount1
KC_BLOB_CONTAINER_EVIDENCIA=evidencia

# Vacío en local: el servicio usa la cadena predeterminada de Azurite.
KC_AZURE_STORAGE_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# ClamAV
# ------------------------------------------------------------------------------
# Si el worker se ejecuta desde VS Code:
KC_CLAMAV_HOST=localhost

# Si el worker se ejecuta dentro de Docker Compose, utilizar:
# KC_CLAMAV_HOST=clamav

KC_CLAMAV_PORT=3310
KC_CLAMAV_TIMEOUT_S=30

# ------------------------------------------------------------------------------
# Bóveda y JWT
# ------------------------------------------------------------------------------
KC_SECRETS_BACKEND=env
KC_JWT_PRIVATE_KEY=
KC_JWT_PUBLIC_KEY=
KC_JWT_PRIVATE_KEY_SVC=
KC_JWT_PUBLIC_KEY_SVC=

# ------------------------------------------------------------------------------
# LLM local
# ------------------------------------------------------------------------------
KC_LLM_FLASH_BASE_URL=http://localhost:8081/v1
KC_LLM_FLASH_MODEL=deepseek-v4-flash
KC_LLM_FLASH_API_KEY=mock-local-key

KC_LLM_PRO_BASE_URL=http://localhost:8081/v1
KC_LLM_PRO_MODEL=deepseek-v4-pro
KC_LLM_PRO_API_KEY=mock-local-key

KC_LLM_FABLE_BASE_URL=http://localhost:8081/v1
KC_LLM_FABLE_MODEL=claude-fable-5
KC_LLM_FABLE_API_KEY=mock-local-key

# ------------------------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------------------------
KC_EMBEDDINGS_URL=http://localhost:8080
KC_EMBEDDINGS_DIM=1024

# ------------------------------------------------------------------------------
# Correo local
# ------------------------------------------------------------------------------
KC_SMTP_HOST=localhost
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@kallicode.dev
KC_SMTP_TLS=false

# ------------------------------------------------------------------------------
# API interna y orquestador
# ------------------------------------------------------------------------------
KC_INTERNAL_API_BASE_URL=http://localhost:8000/internal/v1
KC_ORQUESTADOR_SERVICIO=orquestador

# ------------------------------------------------------------------------------
# CORS y HTTP
# ------------------------------------------------------------------------------
KC_CORS_ORIGINS=https://kallicode.vercel.app,http://localhost:5173
KC_ALLOWED_HOSTS=localhost,127.0.0.1,test,testserver
KC_MAX_BODY_BYTES=5242880