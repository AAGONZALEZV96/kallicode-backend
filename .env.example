# Kallicode backend - configuracion local

KC_ENV=local
KC_LOG_LEVEL=DEBUG
KC_LOG_FORMATO=texto

# DSN de aplicacion.
# Rol sujeto a RLS: kallicode_app
KC_DATABASE_URL=postgresql+asyncpg://kallicode_app:dev@localhost:5432/kallicode

# DSN administrativo.
# Rol con BYPASSRLS: kallicode_admin
KC_DATABASE_URL_ADMIN=postgresql+asyncpg://kallicode_admin:dev@localhost:5432/kallicode

KC_REDIS_URL=redis://localhost:6379/0
KC_REDIS_PASSWORD=dev

KC_BLOB_ACCOUNT_URL=http://localhost:10000/devstoreaccount1
KC_BLOB_CONTAINER_EVIDENCIA=evidencia

# JWT vacio en local: se genera un par efimero
KC_JWT_PRIVATE_KEY=
KC_JWT_PUBLIC_KEY=

KC_ACCESS_TOKEN_TTL_MIN=30
KC_REFRESH_TOKEN_TTL_DIAS=30
KC_SVC_TOKEN_TTL_MIN=5

# LLM
KC_LLM_FLASH_BASE_URL=http://localhost:9001/v1
KC_LLM_FLASH_MODEL=deepseek-v4-flash
KC_LLM_FLASH_API_KEY=dev

KC_LLM_PRO_BASE_URL=http://localhost:9001/v1
KC_LLM_PRO_MODEL=deepseek-v4-pro
KC_LLM_PRO_API_KEY=dev

KC_LLM_FABLE_BASE_URL=https://api.anthropic.com/v1
KC_LLM_FABLE_MODEL=claude-fable-5
KC_LLM_FABLE_API_KEY=

KC_LLM_TIMEOUT_S=120
KC_LLM_MAX_REINTENTOS_ESQUEMA=2
KC_LLM_UMBRAL_CONFIANZA=0.75

# Embeddings
KC_EMBEDDINGS_URL=http://localhost:8080
KC_EMBEDDINGS_DIM=1024

# SMTP local
KC_SMTP_HOST=localhost
KC_SMTP_PORT=1025
KC_SMTP_USER=
KC_SMTP_PASSWORD=
KC_SMTP_TLS=false
KC_SMTP_FROM=no-reply@kallicode.dev

# Polling
KC_POLL_NOTIFICACIONES_S=30
KC_POLL_TABLERO_S=60

KC_CORS_ORIGINS=http://localhost:5173