# Kallicode backend — configuración local (ver §5 Especificación de Entorno)
KC_ENV=local
KC_LOG_LEVEL=DEBUG
KC_LOG_FORMATO=texto
KC_DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/kallicode
KC_REDIS_URL=redis://localhost:6379/0
KC_BLOB_ACCOUNT_URL=http://localhost:10000/devstoreaccount1
# JWT: vacío en local => par efímero (solo desarrollo)
KC_JWT_PRIVATE_KEY=
KC_JWT_PUBLIC_KEY=
# LLM: tres categorías (D. julio-2026)
KC_LLM_FLASH_BASE_URL=http://localhost:9001/v1
KC_LLM_FLASH_MODEL=deepseek-v4-flash
KC_LLM_PRO_BASE_URL=http://localhost:9001/v1
KC_LLM_PRO_MODEL=deepseek-v4-pro
KC_LLM_FABLE_BASE_URL=https://api.anthropic.com/v1
KC_LLM_FABLE_MODEL=claude-fable-5
KC_LLM_FABLE_API_KEY=
# Embeddings BGE-M3
KC_EMBEDDINGS_URL=http://localhost:8080
# SMTP (Mailpit local)
KC_SMTP_HOST=localhost
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@kallicode.dev
KC_CORS_ORIGINS=http://localhost:5173
